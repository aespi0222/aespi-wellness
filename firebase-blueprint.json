{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "A client inquiry submitted via the contact form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person inquiring."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the person inquiring."
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the person inquiring."
        },
        "service": {
          "type": "string",
          "description": "The service they are interested in."
        },
        "message": {
          "type": "string",
          "description": "The message or question from the client."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the inquiry was submitted."
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "closed"],
          "description": "The current status of the inquiry."
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "CommunityInquiry": {
      "title": "CommunityInquiry",
      "description": "An inquiry submitted via the Community Healthy Ageing Access Programme form.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the senior or caregiver."
        },
        "phone": {
          "type": "string",
          "description": "Phone number."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address."
        },
        "age": {
          "type": "string",
          "description": "Age of the senior client."
        },
        "chasCardType": {
          "type": "string",
          "description": "Type of CHAS card (e.g. Blue, Orange)."
        },
        "message": {
          "type": "string",
          "description": "Enquiry details/message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of creation."
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "closed"],
          "description": "Status of the access enquiry."
        }
      },
      "required": ["name", "phone", "email", "age", "chasCardType", "createdAt", "status"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Collection of client inquiries."
    },
    "/community_inquiries/{inquiryId}": {
      "schema": "CommunityInquiry",
      "description": "Collection of submissions for the Community Healthy Ageing Access Programme."
    }
  }
}
